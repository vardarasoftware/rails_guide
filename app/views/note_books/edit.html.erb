<h1>Edit NoteBook</h1>

<%= form_with model: @note_book, local: true do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :content %>
    <%= form.text_area :content %>
  </div>

  <div>
    <%= form.label :author %>
    <%= form.text_area :author %>
  </div>

  <div>
      <%= form.label :published_date, "Published Date" %>
      <%= form.date_select :published_date %>
  </div>

  <div>
    <%= form.label :reminder_time, "Reminder Time" %>
    <%= form.time_select :reminder_time, minute_step: 5 %>
  </div>

  <div>
    <%= form.label :last_edited_at, "Last Edited At" %>
    <%= form.datetime_select :last_edited_at %>
  </div>

  <div>
    <%= form.label :time_zone, "Time Zone" %>
    <%= form.time_zone_select :time_zone %>
  </div>

  <div>
    <label>Tags:</label>
    <input name="notebook[tags][]" type="text" placeholder="Tag 1">
    <input name="notebook[tags][]" type="text" placeholder="Tag 2">
    <input name="notebook[tags][]" type="text" placeholder="Tag 3">
  </div>

  <div>
    <%= form.submit "Update NoteBook" %>
  </div>

  <div>
    <%= form.submit "Delete NoteBook", data: { confirm: "Are you sure?" } %>
  </div>

<% end %>

<%= link_to "Back", note_books_path %>
