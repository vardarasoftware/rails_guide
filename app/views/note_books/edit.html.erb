<h1>Edit NoteBook</h1>

<%= form_with model: @note_book, local: true do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :content %>
    <%= form.text_area :content %>
  </div>

  <div>
    <%= form.label :author %>
    <%= form.text_area :author %>
  </div>

  <div>
    <%= form.submit "Update NoteBook" %>
  </div>

  <div>
    <%= form.submit "Delete NoteBook", data: { confirm: "Are you sure?" } %>
  </div>

<% end %>

<%= link_to "Back", note_books_path %>
