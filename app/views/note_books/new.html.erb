<%= form_with model: @note_book do |form| %>
    <div>
      <%= form.label :title %>
      <%= form.text_field :title %>
    </div>
    <div>
      <%= form.label :author %>
      <%= form.text_field :author %>
    </div>
    <div>
      <%= form.label :content %>
      <%= form.text_field :content %>
    </div>
    <%= form.submit "Create Notebook" %>
  <% end %>

<%= link_to "Back", note_books_path %>
