<h1>Listing NoteBooks</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Content</th>
      <th>Author</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @note_books.each do |note_book| %>
      <tr>
        <td><%= note_book.title %></td>
        <td><%= note_book.content %></td>
        <td><%= note_book.author %></td>
        <td><%= link_to "Show", note_book %></td>
        <td><%= link_to "Edit", edit_note_book_path(note_book) %></td>
        <td><%= link_to "Destroy", note_book, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "New NoteBook", new_note_book_path %>
