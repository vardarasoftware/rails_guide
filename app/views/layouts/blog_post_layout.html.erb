<!DOCTYPE html>
<html>
<head>
  <title>Blog Post Layout</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", media: "all" %>
  <%= javascript_include_tag "application" %>
</head>
<body>
  <header>
    <h1>Welcome to My Blog</h1>
  </header>

  <main>
    <%= yield %>
  </main>

  <footer>
    <p>&copy; <%= Time.now.year %> My Blog. All rights reserved.</p>
  </footer>
</body>
</html>
