<p style="color: green"><%= notice %></p>

<%= render partial: "blog_post", locals: { blog_post: @blog_post } %>

<h1>Blog Post Details</h1>

<%= render layout: "box", locals: { blog_post: @blog_post } do %>
  <%= render partial: "blog_post", locals: { blog_post: @blog_post } %>
<% end %>

<% if @blog_post.image_url.present? %>
  <%= image_tag(@blog_post.image_url, alt: @blog_post.title, class: "blog-image") %>
<% else %>
  <%= image_tag("default_image.png", alt: "Default Image", class: "blog-image") %>
<% end %>

<div>
  <h2><%= @blog_post.title %></h2>
  <p><%= @blog_post.content %></p>
</div>

<% if @blog_post.present? %>
  <p>Posted <%= time_ago_in_words(@blog_post.created_at) %> ago</p>
<% else %>
  <p>No post found</p>
<% end %>

<div>
  <%= link_to "Edit this blog post", edit_blog_post_path(@blog_post) %> |
  <%= link_to "Back to blog posts", blog_posts_path %>

  <%= button_to "Destroy this blog post", @blog_post, method: :delete %>
</div>

<button onclick="showAlert()">Show Blog Content</button>

<%= javascript_tag do %>
  function showAlert() {
    var blogContent = "<%= escape_javascript(@blog_post.content) %>";
    alert(blogContent);
  }
<% end %>
