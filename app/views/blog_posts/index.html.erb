<p style="color: green"><%= notice %></p>

<h1>Blog posts</h1>

<% @welcome_message = capture do %>
  <p>Welcome! Today’s date is <%= Time.current.strftime("%Y-%m-%d") %></p>
<% end %>

<%= @welcome_message %>  <%# Displays stored content %>

<%= link_to "New blog post", new_blog_post_path %>

<% @blog_posts.each do |post| %>
  <h2><%= post.title %></h2>
  <p><%= post.content %></p>
<% end %>

<div id="blog_posts">
  <% @blog_posts.each do |blog_post| %>
    <%= render partial: "blog_post", collection: @blog_posts %>
    <p>
      <%= link_to "Show this blog post", blog_post %>
    </p>
  <% end %>
</div>
