<h1>New Blog Post</h1>

<%= form_with(model: @blog_post, local: true) do |form| %>
  <div>
    <%= form.label :title, "Title" %><br>
    <%= form.text_field :title, required: true %>
  </div>

  <div>
    <%= form.label :content, "Content" %><br>
    <%= form.text_area :content, required: true, rows: 5 %>
  </div>

  <div>
    <%= form.submit "Create Blog Post" %>
  </div>
<% end %>

<div>
<%= link_to "Back to Blog Posts", blogposts_path %>
</div>
